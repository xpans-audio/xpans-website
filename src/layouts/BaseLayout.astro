---
import MenuBar from "../components/menu-bar/MenuBar.astro";
import Footer from "../components/footer/Footer.astro";
const { title, scrollWrapper, animateMenuBar } = Astro.props;
---

<html lang="en">
    <head>
        <link rel="icon" type="image/x-icon" href="/favicon.svg" />
        <title>{title}</title>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta content="xpans.audio" property="og:title" />
        <meta content="website" property="og:type" />
        <meta
            property="og:description"
            content="xpans — an open ecosystem for spatial audio"
        />
        <meta
            property="og:image"
            content="https://xpans.audio/_assets/brand/wordmark_logo_combo_color_fill.jpg"
        />
        <link rel="sitemap" href="/sitemap-index.xml" />
    </head>
    <body>
        <MenuBar animate={animateMenuBar} />
        <div class:list={[{ scrollable: scrollWrapper }]}>
            <div class="content">
                <div class="scroll-spacer"></div>
                <slot />
            </div>
            <Footer />
        </div>
    </body>
</html>

<style lang="scss" is:global>
    @use "../styles/xpans";
    @use "../styles/menu-bar";
    /*html {
        height: 100vh;
        overflow-x: hidden;
    }*/

    ::selection {
        background-color: xpans.$accent-purple;
    }
    .scroll-spacer {
        height: menu-bar.$menu-bar-height;
    }
    .scrollable {
        position: absolute;
        top: 0;
        width: 100vw;
        height: 100vh;
        perspective: 3rem;
        transform-style: preserve-3d;
        overflow-x: hidden;
        overflow-y: scroll;
    }
    .content {
        transform-style: preserve-3d;
        /*TODO: DE-HARDCODE FOOTER HEIGHT*/
        min-height: calc(100vh - 163.2px);
    }
    body {
        scrollbar-width: thin;
        font-synthesis: none;
        text-rendering: optimizeLegibility;
        margin: 0;
        font-family: spaceGrotesk;
        color: xpans.$extra-light-purple;
        background-color: xpans.$extra-dark-purple;
    }
    p {
        font-size: 1rem;
        font-weight: 400;
    }
    h1 {
        margin: 0;
        font-size: 4rem;
        font-weight: 700;
    }

    h2 {
        font-size: 2rem;
        font-weight: 600;
    }
    img {
        display: block;
        max-inline-size: 100%;
        vertical-align: bottom;
    }
    svg {
        display: block;
        max-inline-size: 100%;
        vertical-align: bottom;
    }
</style>
