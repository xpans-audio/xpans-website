---
import product from "../../data/create/frontier.json";
import downloadInfo from "../../data/downloads/frontier.json";
import infoImage from "../../assets/create_Frontier.svg";
import CreateProductTemplate from "../../layouts/CreateProductTemplate.astro";
import { Image } from "astro:assets";
---

<CreateProductTemplate {product} {downloadInfo}>
    <div slot="description">
        <p>
            Render spatial scenes to deliverable audio files in a standalone
            desktop app.
        </p>
        <h3>Stability Statement</h3>
        <p>
            This software is early in development and may change drastically
            across versions.
        </p>
    </div>
    <Image slot="image" src={infoImage} alt="" />
</CreateProductTemplate>

<style lang="scss">
    @use "../../styles/xpans";
    img {
        border-radius: xpans.$border-radius;
        height: auto;
        object-fit: cover;
    }
    h3 {
        font-size: 1.25rem;
        margin-bottom: xpans.space-length(1.6rem, 1.25rem, 1rem);
    }
    p {
        margin-top: 0;
    }
</style>
